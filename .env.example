# QuestionTrail Server Environment Configuration
# Copy this file to .env and supply keys as needed.
# Secrets remain server-side only; never commit .env to source control.

# Active provider mode: auto | nvidia | gemini | mock
LLM_PROVIDER=auto

# Ordered fallback chain for structured LLM tasks
LLM_FALLBACK_ORDER=["nvidia", "gemini", "cache"]

# NVIDIA NIM (OpenAI-compatible) API configuration
# Acquire key at https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Optional Google Gemini API configuration
# Acquire key at https://aistudio.google.com/
GEMINI_API_KEY=

# Server binding
HOST=0.0.0.0
PORT=8000
